# Include these locations inside the platform's HTTPS server block.
# The Dashboard application has no end-user login in the competition scope.
# Enable platform authentication, Basic Auth, a VPN, or an IP allowlist before exposure.

location = /107-dashboard {
    return 301 /107-dashboard/;
}

location /107-dashboard/ {
    # Optional minimum competition gate:
    # auth_basic "107 Dashboard";
    # auth_basic_user_file /etc/nginx/107-dashboard.htpasswd;

    proxy_pass http://127.0.0.1:8000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;
    client_max_body_size 1m;
}
