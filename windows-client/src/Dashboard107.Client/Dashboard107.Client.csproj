<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>107Dashboard</AssemblyName>
    <RootNamespace>Dashboard107.Client</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets\107dashboard.ico')">Assets\107dashboard.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\107dashboard.ico" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(PayloadPath)')">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="Dashboard107.Client.Payload.server-package.tar.gz" />
  </ItemGroup>

</Project>
